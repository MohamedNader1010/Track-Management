{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "takwene-track-management",
    "Audience": "takwene-track-management-clients",
    "SigningKey": "",
    "ExpiryMinutes": 60
  },
  "DemoUsers": {
    "Users": []
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200/"]
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
